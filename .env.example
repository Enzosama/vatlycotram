# Copy file này thành .env rồi điền giá trị.

# --- Google Sheet backup ---
# VITE_GSHEET_URL=https://script.google.com/macros/s/AKfycb.../exec
VITE_GSHEET_URL=

# --- Gmail SMTP (gửi OTP đặt lại mật khẩu) ---
# SMTP_USER: địa chỉ Gmail gửi thư (ví dụ vobaolong2000@gmail.com)
# SMTP_PASS: App Password 16 ký tự (KHÔNG dùng mật khẩu Gmail thường)
#   Tạo tại: https://myaccount.google.com/apppasswords (yêu cầu bật 2FA)
SMTP_USER=
SMTP_PASS=
